{
  "version": 1,
  "schema": [
    {
      "name": "product",
      "description": "one item offered for sale",
      "props": [
        {
          "name": "title",
          "type": "string",
          "aliases": ["name", "product name", "item"],
          "description": "what the product is called",
          "examples": ["Wireless Keyboard K380"]
        },
        {
          "name": "brand",
          "type": "string",
          "aliases": ["manufacturer", "maker", "vendor"],
          "description": "who makes the product",
          "examples": ["Logitech", "Anker"]
        },
        {
          "name": "price",
          "type": "number",
          "aliases": ["cost", "sale price", "our price"],
          "description": "what the product sells for now, not the list price it was reduced from",
          "examples": ["$39.99", "24.50"]
        },
        {
          "name": "currency",
          "type": "string",
          "aliases": ["cur"],
          "description": "the currency the price is quoted in",
          "examples": ["USD", "EUR", "GBP"]
        },
        {
          "name": "sku",
          "type": "string",
          "aliases": ["item number", "part number", "mpn", "model number"],
          "description": "the seller's identifier for the item",
          "examples": ["920-007559"]
        },
        {
          "name": "availability",
          "type": "string",
          "aliases": ["stock", "in stock", "status"],
          "description": "whether the product can be bought now",
          "examples": ["In stock", "Out of stock", "Backorder"]
        },
        {
          "name": "rating",
          "type": "number",
          "aliases": ["stars", "score", "average rating"],
          "description": "the average customer rating",
          "examples": ["4.5", "3.8"]
        }
      ]
    }
  ]
}
