{
  "version": 1,
  "schema": [
    {
      "name": "article",
      "description": "one published piece of writing",
      "props": [
        {
          "name": "title",
          "type": "string",
          "aliases": [
            "heading"
          ],
          "description": "the article's title, which a feed publishes as <title>",
          "examples": [
            "Council approves new transit line"
          ]
        },
        {
          "name": "author",
          "type": "string",
          "aliases": [
            "byline",
            "written by",
            "reporter",
            "creator",
            "dc:creator"
          ],
          "description": "who wrote it",
          "examples": [
            "Jane Doe"
          ]
        },
        {
          "name": "published",
          "type": "date",
          "aliases": [
            "date",
            "date published",
            "posted",
            "pubdate",
            "updated",
            "dc:date"
          ],
          "description": "when it was published",
          "examples": [
            "2026-03-14"
          ]
        },
        {
          "name": "section",
          "type": "string",
          "aliases": [
            "category",
            "topic",
            "kicker"
          ],
          "description": "where it sits in the publication",
          "examples": [
            "Politics",
            "Business"
          ]
        },
        {
          "name": "summary",
          "type": "string",
          "aliases": [
            "standfirst",
            "excerpt",
            "description",
            "lede",
            "content",
            "subtitle"
          ],
          "description": "a one or two sentence summary of the article",
          "examples": [
            "The vote clears the way for construction to begin in autumn."
          ]
        },
        {
          "name": "link",
          "type": "string",
          "aliases": [
            "url",
            "guid",
            "permalink",
            "href"
          ],
          "description": "the address of the article itself",
          "examples": [
            "https://www.example.com/news/transit-line/"
          ]
        }
      ]
    }
  ]
}
