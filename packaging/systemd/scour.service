[Unit]
Description=scour focused crawler
Documentation=https://github.com/Rangertaha/scour
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/scour server --config /etc/scour/config.toml
User=scour
Group=scour

# StateDirectory and CacheDirectory create and chown these under /var, which is
# why the unit needs no tmpfiles fragment and no preinstall chown.
StateDirectory=scour
CacheDirectory=scour

Restart=on-failure
RestartSec=5s

# A crawl that is interrupted loses whatever it had not yet written, so a stop
# asks politely first and only then insists. The server drains in-flight jobs
# on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=45s

# scour fetches untrusted documents and can drive a browser, so it gets as
# little of the system as it can work with.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
# AF_UNIX is needed for DNS resolution over a local resolver socket.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
